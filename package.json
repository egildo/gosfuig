  "description": "Perceptual (OKLCH) design-system palette generator with contrast validation and W3C token export",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
